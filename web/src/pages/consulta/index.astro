---
import Base from '../../layouts/Base.astro';
import Banda from '../../components/Banda.astro';
import banco from '../../data/banco-encuestas.json';
const MET = { aleatoria: 'Muestra aleatoria', panel: 'Panel en línea', abierta: 'Abierta en línea', redes: 'Redes sociales' };
const ORDEN = ['aleatoria', 'panel', 'abierta', 'redes'];
const destacadas = [...banco.encuestas].filter((e) => e.estado !== 'pendiente').sort((a, b) => b.anio - a.anio || ORDEN.indexOf(a.metodo) - ORDEN.indexOf(b.metodo)).slice(0, 6);
---
<Base titulo="Consultas" seccion="consulta" ancho
  descripcion="Consultas ciudadanas no vinculantes sobre propuestas, temas de actualidad y la gestión del gobierno. Voto anónimo; se publican solo los totales.">
  <Banda imagen="/img/fotos/encuestas.jpg" posicion="35% center" lateral={['Valorar', 'Priorizar', 'Aceptar', 'Rechazar']}>
    <span class="barra"></span>
    <h1>Consultas</h1>
    <p class="lema">Consultas ciudadanas no vinculantes</p>
    <p class="entradilla">Las consultas ayudan a identificar prioridades y grados de aceptación entre quienes participan. Sus resultados no se presentan como opinión representativa de toda la población. El voto es anónimo y solo se publican los totales.</p>
  </Banda>
  <div class="contenedor">
    <div class="seccion">
      <div class="tabs-consulta" role="tablist">
        <button type="button" role="tab" aria-selected="true" aria-controls="tab-actual" id="b-actual">Consulta actual</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="tab-anteriores" id="b-anteriores">Consultas cerradas</button>
      </div>
      <div class="panel-tab" id="tab-actual" role="tabpanel" aria-labelledby="b-actual">
      <article class="panel consulta-tarjeta">
        <span class="num">01</span>
        <div>
          <p class="antetitulo">Consulta en curso · abierta desde el 27 de marzo de 2026</p>
          <h2>Continuidad o cambio</h2>
          <p class="entradilla">Parte de una declaración de Miguel Díaz-Canel: «Mi continuidad o la de cualquier otra persona que en determinado momento tenga una responsabilidad de este nivel en nuestro país, depende del pueblo».</p>
          <div class="marcador" id="marcador" aria-live="polite">
            <div class="fila"><span>Continuidad</span><span class="barra-voto"><span data-barra="continuidad"></span></span><span class="pct" data-pct="continuidad">–</span></div>
            <div class="fila cambio"><span>Cambio</span><span class="barra-voto"><span data-barra="cambio"></span></span><span class="pct" data-pct="cambio">–</span></div>
          </div>
          <p class="discreto" id="total-consulta">Cargando resultados…</p>
          <div class="acciones">
            <a class="boton rojo" href="/consulta/continuidad-o-cambio/">Participa <i class="fi fi-br-arrow-right" aria-hidden="true"></i></a>
            <a class="boton" href="/consulta/continuidad-o-cambio/#resultados">Resultados completos</a>
          </div>
        </div>
      </article>
      </div>
      <div class="panel-tab" id="tab-anteriores" role="tabpanel" aria-labelledby="b-anteriores" hidden>
        <div class="panel"><p class="entradilla" style="margin:0">Todavía no hay consultas cerradas. Cuando una consulta termine, sus resultados quedarán aquí.</p></div>
      </div>
      <section class="cons-banco">
        <div class="cons-banco-cab">
          <div>
            <p class="antetitulo">Banco de encuestas · {banco.encuestas.length} registradas</p>
            <h2 class="vista-titulo">Lo que dice la gente</h2>
            <p>Encuestas y sondeos sobre Cuba hechos fuera del Estado, cada uno con su método. Las cifras de encuestas distintas no se suman.</p>
          </div>
          <a class="boton rojo" href="/consulta/encuestas/">Ver todas <i class="fi fi-br-arrow-right" aria-hidden="true"></i></a>
        </div>
        <div class="be-rejilla">
          {destacadas.map((e) => (
            <article class:list={['be-t', `m-${e.metodo}`]}>
              <div class="be-t-cab"><span class="be-met">{MET[e.metodo]}</span></div>
              <div class="be-cifra"><strong>{e.dato}</strong><span>{e.datoTexto}</span></div>
              <h3 class="be-h3">{e.url ? <a href={e.url} rel="noopener" target={e.url.startsWith('/') ? undefined : '_blank'}>{e.titulo}</a> : e.titulo}</h3>
              <p class="be-meta">{e.autor} · {e.fecha} · {e.n}</p>
            </article>
          ))}
        </div>
      </section>
      <h2 class="vista-titulo">Próximas consultas</h2>
      <ul class="tipos-consulta">
        <li><span class="num">02</span><span class="etiqueta">En preparación</span><h3>Termómetro de gestión</h3><p>Valoración periódica del desempeño del gobierno y de sus dirigentes, como se mide la aprobación en otros países. Una herramienta de transparencia que hoy no existe en Cuba.</p></li>
        <li><span class="num">03</span><span class="etiqueta">En preparación</span><h3>Consultas sobre propuestas</h3><p>Preguntas sobre las propuestas del banco: qué priorizar, qué alternativa prefieres y por qué. Sus resultados alimentan la Plataforma plural de gobierno.</p></li>
        <li><span class="num">04</span><span class="etiqueta">En preparación</span><h3>Temas de actualidad</h3><p>Consultas breves sobre asuntos del momento que afectan a la vida colectiva.</p></li>
      </ul>
      <article class="panel solicitud-civica">
        <p class="antetitulo">Solicitud enviada · 11 de julio de 2026</p>
        <h2>Que Cuba pueda decidir sin miedo</h2>
        <p>Una solicitud internacional para promover una consulta cubana libre, directa, secreta y verificable, con observación independiente y garantías contra la coacción y las represalias.</p>
        <a class="enlace-flecha" href="/consulta/solicitud-consulta-civica/">Conocer la solicitud <i class="fi fi-br-arrow-right" aria-hidden="true"></i></a>
      </article>
      <p class="discreto" style="margin-top:18px">Los resultados reflejan a quienes participan y no a toda la población.</p>
    </div>
  </div>
  <script is:inline>
    document.querySelectorAll('.tabs-consulta [role=tab]').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('.tabs-consulta [role=tab]').forEach((x) => {
        const sel = x === b; x.setAttribute('aria-selected', String(sel));
        document.getElementById(x.getAttribute('aria-controls')).hidden = !sel;
      });
    }));
  </script>
  <script>
    const URL_SB = 'https://pfjcumyygdwslwtrlebr.supabase.co';
    const CLAVE = 'sb_publishable_gaor3DqGUprtjEQOmijZeQ_52oV_og8';
    const total = document.getElementById('total-consulta');
    fetch(`${URL_SB}/rest/v1/rpc/consulta_resultados`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', apikey: CLAVE, Authorization: `Bearer ${CLAVE}` },
      body: JSON.stringify({ p_consulta: 'continuidad_2026_03_27' }),
    }).then((r) => (r.ok ? r.json() : Promise.reject(r.status))).then((d) => {
      const t = d.total || 0;
      for (const k of ['continuidad', 'cambio']) {
        const p = t ? Math.round((d[k] / t) * 100) : 0;
        const barra = document.querySelector(`[data-barra="${k}"]`);
        const pct = document.querySelector(`[data-pct="${k}"]`);
        if (barra) requestAnimationFrame(() => { barra.style.width = `${p}%`; });
        if (pct) pct.textContent = `${p}%`;
      }
      if (total) total.textContent = `${t} votos · ${d.cuba || 0} desde Cuba · ${d.extranjero || 0} desde el extranjero`;
    }).catch(() => { if (total) total.textContent = 'Los resultados se pueden ver en la página de la consulta.'; });
  </script>
</Base>
