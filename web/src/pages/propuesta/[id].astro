---
import Base from '../../layouts/Base.astro';
import Quienes from '../../components/Quienes.astro';
import {
  propuestas, propPorId, cuestionesDe, catPorClave, docPorId, documentosDe,
  autoriasCentrales, recortar, tonoCategoria, iconoCategoria, TIPOS_FUENTE,
} from '../../lib/banco.js';

export function getStaticPaths() {
  return propuestas.map((c) => ({ params: { id: c.id }, props: { c } }));
}
const { c } = Astro.props;
const cat = catPorClave.get(c.categoria);
const centrales = autoriasCentrales(c);
const qs = cuestionesDe(c.id);

// Cada documento una sola vez, con lo que aporta a esta propuesta.
const papeles = new Map();
const anotar = (id, rol) => { if (!papeles.has(id)) papeles.set(id, []); if (!papeles.get(id).includes(rol)) papeles.get(id).push(rol); };
c.documentos.forEach((id) => anotar(id, 'Idea central'));
c.incisos.forEach((i) => i.documentos.forEach((id) => anotar(id, `Inciso ${i.letra})`)));
c.variantes.forEach((v) => v.documentos.forEach((id) => anotar(id, 'Variante')));
c.analizan.forEach((id) => anotar(id, 'Análisis del problema'));
const lista = [...papeles.entries()]
  .map(([id, roles]) => ({ d: docPorId.get(id), roles }))
  .filter((e) => e.d)
  .sort((a, b) => Number(!a.roles.includes('Idea central')) - Number(!b.roles.includes('Idea central')) || (a.d.anio ?? 9999) - (b.d.anio ?? 9999));
const total = documentosDe(c).length;

const url = new URL(Astro.url.pathname, Astro.site).toString();
const textoCompartir = `${c.titulo}. ${recortar(c.texto, 200)}`;
---
<Base titulo={c.titulo} seccion="propuestas" imagen={`/og/propuesta/${c.id}.png`}
  descripcion={`${recortar(c.texto, 150)} La plantean ${total} ${total === 1 ? 'documento' : 'documentos'}.`}>
  <nav class="migas" aria-label="Ruta">
    <a href="/propuestas/">Propuestas</a><span aria-hidden="true">›</span>
    <a href={`/propuestas/categoria/${cat.clave}/`}>{cat.nombre}</a>
  </nav>

  <article class="panel ficha-consolidada" style={tonoCategoria(cat.clave)}>
    <p class="antetitulo"><i class={iconoCategoria(cat.clave)} aria-hidden="true"></i>{cat.nombre}</p>
    <h1>{c.titulo}</h1>
    <p class="texto-consolidado">{c.texto}</p>
    <p class="discreto nota-redaccion">Redacción de ENTRE TODOS a partir de {total} {total === 1 ? 'documento' : 'documentos'}, respetando su lenguaje. Cada documento enlaza a su original.</p>
    <div class="respaldo">
      <span class="dato-titulo">La {centrales.length === 1 ? 'plantea' : 'plantean'}</span>
      <ul class="chips">{centrales.map((a) => <li>{a}</li>)}</ul>
    </div>
    <section id="valoracion" class="valoracion" data-propuesta={c.id} aria-label="Valorar esta propuesta"></section>
    <div class="acciones">
      <a class="boton" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} rel="noopener" target="_blank"><i class="fi fi-br-share" aria-hidden="true"></i>Facebook</a>
      <a class="boton" href={`https://wa.me/?text=${encodeURIComponent(`${textoCompartir} ${url}`)}`} rel="noopener" target="_blank"><i class="fi fi-br-comment-alt" aria-hidden="true"></i>WhatsApp</a>
      <button class="boton" type="button" data-copiar={url} hidden><i class="fi fi-br-link-alt" aria-hidden="true"></i><span>Copiar enlace</span></button>
    </div>
  </article>

  {c.incisos.length > 0 && (
    <section aria-labelledby="t-incisos">
      <h2 id="t-incisos">Incisos y precisiones de las fuentes</h2>
      <p class="discreto">Elementos que alguna fuente añade a la idea central. Cada uno indica quién lo propone.</p>
      <ol class="incisos">
        {c.incisos.map((i) => (
          <li>
            <span class="letra" aria-hidden="true">{i.letra}</span>
            <div>
              <p>{i.texto}</p>
              <p class="quien">Lo propone: <Quienes ids={i.documentos} /></p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  {c.variantes.length > 0 && (
    <section aria-labelledby="t-variantes">
      <h2 id="t-variantes">Diferencias entre las fuentes</h2>
      <p class="discreto">Puntos en los que las fuentes difieren. Se muestra cada posición con su fuente.</p>
      <div class="desplazable">
        <table class="tabla">
          <thead><tr><th scope="col">Modalidad</th><th scope="col">Quién la propone</th></tr></thead>
          <tbody>
            {c.variantes.map((v) => (
              <tr><td>{v.texto}</td><td><Quienes ids={v.documentos} /></td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {c.nota && <div class="resumen"><strong>Nota editorial</strong>{c.nota}</div>}

  {qs.map((q) => (
    <section class="panel cuestion" aria-labelledby={`t-${q.id}`}>
      <p class="antetitulo"><i class="fi fi-br-shuffle" aria-hidden="true"></i>{q.excluyentes ? 'Alternativas incompatibles' : 'Otras respuestas a la misma cuestión'}</p>
      <h2 id={`t-${q.id}`}>{q.pregunta}</h2>
      {q.texto && <p class="discreto">{q.texto}</p>}
      <ul class="opciones">
        {q.opciones.map((o) => (
          <li>{o === c.id ? <strong>{propPorId.get(o).titulo} <span class="discreto">(esta propuesta)</span></strong> : <a href={`/propuesta/${o}/`}>{propPorId.get(o).titulo}</a>}</li>
        ))}
      </ul>
    </section>
  ))}

  <section aria-labelledby="t-fuentes">
    <h2 id="t-fuentes">Documentos</h2>
    <p class="discreto">Los documentos públicos de los que sale esta propuesta, con lo que aporta cada uno. Cada enlace lleva al original.</p>
    <details class="fuentes-detalle" open={lista.length <= 4}>
      <summary>Ver los {lista.length} documentos</summary>
      <ul class="lista">
        {lista.map(({ d, roles }) => (
          <li class="tarjeta">
            <h3><a href={d.url} rel="noopener" target="_blank">{d.titulo}</a></h3>
            <p class="autoria">{d.actor ? <a href={`/actores/${d.actor}/`}>{d.autoria}</a> : d.autoria}{d.anio && <span class="discreto"> · {d.anio}</span>}<span class="discreto"> · {TIPOS_FUENTE[d.tipo]}</span></p>
            <div class="etiquetas">{roles.map((r) => <span class="etiqueta">{r}</span>)}</div>
          </li>
        ))}
      </ul>
    </details>
  </section>

  <section id="aportes" class="aportes" data-propuesta={c.id} aria-labelledby="t-aportes">
    <h2 id="t-aportes">Aportes de la ciudadanía</h2>
    <p class="discreto">Mejoras, objeciones, incisos y evidencias. Se publican tras moderación y se pueden apoyar.</p>
    <div data-aportes></div>
  </section>

  <script>
    for (const b of document.querySelectorAll('[data-copiar]')) {
      if (!navigator.clipboard) continue;
      b.hidden = false;
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.copiar);
          const s = b.querySelector('span'); const antes = s.textContent;
          s.textContent = 'Enlace copiado'; setTimeout(() => (s.textContent = antes), 2000);
        } catch {}
      });
    }
  </script>
  <script>
    import('../../lib/participacion.js').then((m) => m.iniciarParticipacion());
  </script>
</Base>
