---
import Base from '../layouts/Base.astro';
import Banda from '../components/Banda.astro';
import datos from '../data/publico.json';
const categorias = [...datos.categorias].sort((a, b) => a.orden - b.orden);

---
<Base titulo="¿Cuál es el plan?" seccion="plan" ancho
  descripcion="De tus preocupaciones a las propuestas: qué plantean las organizaciones de la sociedad civil cubana para los problemas que más preocupan.">
  <Banda imagen="/img/fotos/cat-modelo_pais.jpg" lateral={['Preocupación', 'Propuesta', 'Valoración', 'Plan']}>
    <span class="barra"></span>
    <h1>¿Cuál es<br />el plan?</h1>
    <p class="lema">Espacio de colaboración · próximamente</p>
    <p class="entradilla">Un espacio para pasar de lo que preocupa a la gente a las propuestas que ya existen. Lo desarrollará una organización colaboradora de ENTRE TODOS.</p>
  </Banda>

  <div class="contenedor">
    <section class="seccion">
      <!-- Punto de montaje del módulo «¿Cuál es el plan?». El equipo colaborador sustituye este bloque por su componente. -->
      <div id="modulo-plan" data-modulo="cual-es-el-plan">
        <div class="aviso-proximo">
          <h2>Espacio de colaboración con otra organización</h2>
          <p>Esta sección la está preparando una organización colaboradora. Su contenido se publicará aquí próximamente. Mientras tanto, puedes empezar por los temas del banco de propuestas.</p>
        </div>
      </div>
    </section>

    <section class="seccion" id="preocupaciones">
      <h2 class="vista-titulo">¿Qué te preocupa?</h2>
      <p class="entradilla">Elige un tema para ver las propuestas que se han hecho.</p>
      <ul class="preocupaciones">
        {categorias.map((c) => (
          <li><a href={`/propuestas/categoria/${c.clave}/`}>
            <span class="duo"><img src={`/img/fotos/cat-${c.clave}.jpg`} alt="" loading="lazy" /></span>
            <span class="txt"><strong>{c.nombre}</strong><span>{c.descripcion}</span></span>
            <i class="fi fi-br-arrow-right" aria-hidden="true"></i>
          </a></li>
        ))}
      </ul>
    </section>

  </div>
</Base>
