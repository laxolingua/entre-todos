---
import Base from '../../layouts/Base.astro';
import { fuentes, autoriaFuente, TIPOS_FUENTE } from '../../lib/banco.js';
const orden = [...fuentes].sort((a, b) => b.propuestas - a.propuestas || a.ref - b.ref);
---
<Base titulo="Fuentes del banco" seccion="archivo"
  descripcion={`Los ${fuentes.length} documentos de los que proceden las propuestas del banco, con enlace a cada original.`}>
  <h1>Fuentes</h1>
  <p class="entradilla">Los {fuentes.length} documentos públicos de los que se han extraído las citas. Cada uno enlaza a su original y tiene su autoría verificada.</p>
  <div class="desplazable">
    <table class="tabla">
      <thead><tr><th scope="col">Documento</th><th scope="col">Autoría</th><th scope="col">Tipo</th><th scope="col">Citas</th></tr></thead>
      <tbody>
        {orden.map((f) => (
          <tr>
            <td><a href={`/fuentes/${f.ref}/`}>{f.documento}</a>{f.duplicado_de && <div class="discreto">Mismo documento que la fuente {f.duplicado_de}</div>}</td>
            <td>{autoriaFuente(f) ?? <span class="discreto">Por confirmar</span>}</td>
            <td>{TIPOS_FUENTE[f.tipo]}</td>
            <td>{f.propuestas}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
