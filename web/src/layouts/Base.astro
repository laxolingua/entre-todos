---
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-700.css';
import '@fontsource/barlow-condensed/latin-300.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow-condensed/latin-800.css';
import '@fontsource/montserrat/latin-900.css';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion: string;
  imagen?: string;     // ruta de la imagen 1200x630 para compartir, relativa al sitio
  seccion?: 'inicio' | 'propuestas' | 'academia' | 'consulta' | 'sobre' | 'cuestiones' | 'archivo' | 'fuentes' | 'actores' | 'metodo' | 'datos' | 'plan' | 'seguridad' | 'diversidad' | 'abrazos' | 'perfil' | 'otras';
  ancho?: boolean;     // true: la página controla su propio ancho (portada y secciones con banda)
}
const { titulo, descripcion, imagen = '/og/banco.png', seccion, ancho = false } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenAbs = new URL(imagen, Astro.site);
const tituloCompleto = seccion === 'inicio' ? 'ENTRE TODOS · Voz + Voto' : `${titulo} · ENTRE TODOS`;
const BANCO = ['propuestas', 'cuestiones', 'fuentes', 'actores', 'metodo', 'datos', 'archivo'];
const enBanco = BANCO.includes(seccion ?? '');
const enlaces = [
  { href: '/propuestas/', texto: 'Propuestas', activo: enBanco },
  { href: '/cual-es-el-plan/', texto: '¿Cuál es el plan?', activo: seccion === 'plan' },
  { href: '/academia/', texto: 'Blog A+', activo: seccion === 'academia' },
  { href: '/consulta/', texto: 'Consulta', activo: seccion === 'consulta' },
  { href: '/sobre/', texto: 'Sobre nosotros', activo: seccion === 'sobre' },
];
import sitio from '../data/sitio.json';
const subenlaces = [
  { href: '/propuestas/', texto: 'Todas las propuestas', id: 'propuestas' },
  { href: '/cuestiones/', texto: 'Cuestiones con alternativas', id: 'cuestiones' },
  { href: '/fuentes/', texto: 'Documentos', id: 'fuentes' },
  { href: '/actores/', texto: 'Actores', id: 'actores' },
  { href: '/metodo/', texto: 'Método', id: 'metodo' },
  { href: '/datos/', texto: 'Datos abiertos', id: 'datos' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ENTRE TODOS" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenAbs} />
    <meta name="theme-color" content="#0b1d3f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="/fonts/uicons-br.css" />
    <link rel="stylesheet" href="/fonts/uicons-brands.css" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="cabecera" id="cabecera">
      <div class="contenedor">
        <a class="marca notranslate" translate="no" href="/" aria-label="ENTRE TODOS, inicio"><span class="logo" aria-hidden="true"><span class="l1">Entre</span><span class="l2">Todos</span></span></a>
        <a class="icono-cab perfil-enlace" href="/perfil/" aria-label="Tu perfil"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4.2"/><path d="M3.5 21c1.4-4.2 4.6-6.3 8.5-6.3s7.1 2.1 8.5 6.3"/></svg></a>
        <a class="icono-cab" href="/propuestas/#buscador" aria-label="Buscar propuestas"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7"/><path d="m20 20-4.5-4.5"/></svg></a>
        <button class="menu-boton" type="button" aria-controls="nav-principal" aria-expanded="false" aria-label="Abrir menú"><span class="hamburguesa" aria-hidden="true"><span></span><span></span><span></span></span></button>
        <nav class="nav" id="nav-principal" aria-label="Principal">
          {enlaces.map((e) => <a href={e.href} aria-current={e.activo ? 'page' : undefined}>{e.texto}</a>)}
        </nav>
      </div>
    </header>
    {enBanco && (
      <nav class="subnav" aria-label="Banco de propuestas">
        <div class="contenedor">
          {subenlaces.map((e) => <a href={e.href} aria-current={seccion === e.id ? 'page' : undefined}>{e.texto}</a>)}
        </div>
      </nav>
    )}
    {ancho ? <main id="contenido"><slot /></main> : <main id="contenido" class="contenedor"><slot /></main>}
    <slot name="antes-del-pie" />
    <footer class="pie">
      <div class="contenedor">
        <div>
          <a class="marca notranslate" translate="no" href="/" aria-label="ENTRE TODOS, inicio"><span class="logo" aria-hidden="true"><span class="l1">Entre</span><span class="l2">Todos</span></span></a>
          <p>Plataforma cívica, independiente, plural y no partidista que abre a la ciudadanía la elaboración y valoración de propuestas para los asuntos públicos.</p>
          <p class="pie-seguro"><a href="/seguridad/"><i class="fi fi-br-shield-check" aria-hidden="true"></i> Cómo participar con seguridad</a></p>
          <ul class="pie-redes" aria-label="Redes sociales de ENTRE TODOS">
            <li><a href={sitio.instagram} rel="noopener" target="_blank" aria-label="Instagram: @EntreTodosOrg" title="Instagram @EntreTodosOrg"><i class="fi fi-brands-instagram" aria-hidden="true"></i></a></li>
            {sitio.facebookPagina && <li><a href={sitio.facebookPagina} rel="noopener" target="_blank" aria-label="Página de Facebook de ENTRE TODOS" title="Página de Facebook"><i class="fi fi-brands-facebook" aria-hidden="true"></i><i class="fi fi-br-flag insignia-grupo" aria-hidden="true"></i></a></li>}
            <li><a class="red-grupo" href={sitio.facebookGrupo} rel="noopener" target="_blank" aria-label="Grupo de Facebook de ENTRE TODOS" title="Grupo de Facebook"><i class="fi fi-brands-facebook" aria-hidden="true"></i><i class="fi fi-br-users insignia-grupo" aria-hidden="true"></i></a></li>
          </ul>
        </div>
        <div>
          <h2>Participa</h2>
          <ul>
            <li><a href="/propuestas/">Propuestas</a></li>
            <li><a href="/cual-es-el-plan/">¿Cuál es el plan?</a></li>
            <li><a href="/consulta/">Consultas</a></li>
            <li><a href="/academia/">Blog A+</a></li>
            <li><a href="/abrazos/">Abrazos</a></li>
          </ul>
        </div>
        <div>
          <h2>Explora</h2>
          <ul>
            <li><a href="/diversidad-politica/">Diversidad política</a></li>
            <li><a href="/constituyente/">Proceso constituyente</a></li>
            <li><a href="/cuba-eeuu/">Cuba y Estados Unidos</a></li>
            <li><a href="/actualidad/">Actualidad</a></li>
            <li><a href="/reconstruccion/">Reconstrucción</a></li>
            <li><a href="/datos/">Datos abiertos</a></li>
          </ul>
        </div>
        <div>
          <h2>ENTRE TODOS</h2>
          <ul>
            <li><a href="/sobre/">Sobre nosotros</a></li>
            <li><a href="/metodo/">Método</a></li>
            <li><a href="/seguridad/">Seguridad</a></li>
            <li><a href="/privacidad/">Privacidad</a></li>
            <li><a href={`mailto:${sitio.contacto}`}>Contacto</a></li>
          </ul>
        </div>
      </div>
    </footer>
    <script is:inline>
      const c = document.getElementById('cabecera');
      const b = c?.querySelector('.menu-boton');
      b?.addEventListener('click', () => {
        const abierta = c.classList.toggle('abierta');
        b.setAttribute('aria-expanded', String(abierta));
      });
    </script>
  </body>
</html>
