---
import Base from '../../layouts/Base.astro';
import { documentos, propuestasDeDocumento, TIPOS_FUENTE } from '../../lib/banco.js';
const filas = documentos
  .map((d) => ({ d, n: propuestasDeDocumento(d.id).length }))
  .sort((a, b) => b.n - a.n || (a.d.anio ?? 0) - (b.d.anio ?? 0));
---
<Base titulo="Documentos" seccion="fuentes"
  descripcion={`Los ${documentos.length} documentos públicos de los que salen las propuestas, con enlace a cada original.`}>
  <h1>Documentos</h1>
  <p class="entradilla">Los {documentos.length} documentos públicos de los que salen las propuestas. Cada uno enlaza a su original y tiene su autoría comprobada.</p>
  <div class="desplazable">
    <table class="tabla">
      <thead><tr><th scope="col">Documento</th><th scope="col">Autoría</th><th scope="col">Año</th><th scope="col">Propuestas</th></tr></thead>
      <tbody>
        {filas.map(({ d, n }) => (
          <tr>
            <td><a href={d.url} rel="noopener" target="_blank">{d.titulo}</a><div class="discreto">{TIPOS_FUENTE[d.tipo]}</div></td>
            <td>{d.actor ? <a href={`/actores/${d.actor}/`}>{d.autoria}</a> : d.autoria}</td>
            <td>{d.anio ?? ''}</td>
            <td>{n}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
