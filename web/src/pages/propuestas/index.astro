---
import Base from '../../layouts/Base.astro';
import TarjetaCategoria from '../../components/TarjetaCategoria.astro';
import TarjetaConsolidada from '../../components/TarjetaConsolidada.astro';
import { categorias, meta, propuestas, cuestiones, propPorId } from '../../lib/banco.js';
const t = meta.totales;
// Las propuestas con más documentos detrás: donde más coinciden las fuentes.
const masRespaldadas = [...propuestas].sort((a, b) => b.total_documentos - a.total_documentos || a.orden - b.orden).slice(0, 6);
---
<Base titulo="Propuestas" seccion="propuestas"
  descripcion={`${t.propuestas} propuestas sobre el futuro de Cuba, reunidas a partir de ${t.documentos} documentos públicos.`}>
  <h1>Propuestas para el futuro de Cuba</h1>
  <p class="entradilla">Lo que han propuesto organizaciones, coaliciones y especialistas. Cada idea aparece una sola vez, con todas las fuentes que la plantean; lo que alguna fuente añade va como inciso, con su referencia.</p>
  <ul class="cifras">
    <li><strong>{t.propuestas}</strong> propuestas</li>
    <li><strong>{t.documentos}</strong> documentos</li>
    <li><strong>{t.autorias}</strong> autorías</li>
    <li><strong>{t.cuestiones}</strong> <a href="/cuestiones/">cuestiones con alternativas</a></li>
  </ul>

  <form class="buscador" role="search" action="/propuestas/" method="get" id="buscador">
    <label for="q" class="oculto">Buscar propuestas</label>
    <input id="q" name="q" type="search" placeholder="Buscar: elecciones, vivienda, presos políticos…" autocomplete="off" />
    <button class="boton primario" type="submit"><i class="fi fi-br-search" aria-hidden="true"></i><span>Buscar</span></button>
  </form>
  <div id="resultados" aria-live="polite"></div>

  <div id="categorias">
    <section aria-labelledby="titulo-respaldadas">
      <h2 id="titulo-respaldadas">Donde más fuentes coinciden</h2>
      <ul class="lista">{masRespaldadas.map((c) => <TarjetaConsolidada c={c} mostrarCategoria />)}</ul>
    </section>

    <section aria-labelledby="titulo-categorias">
      <h2 id="titulo-categorias">Por categoría</h2>
      <div class="rejilla">{categorias.map((c) => <TarjetaCategoria c={c} />)}</div>
    </section>

    <section aria-labelledby="titulo-cuestiones">
      <h2 id="titulo-cuestiones">Cuestiones con alternativas</h2>
      <p class="discreto">Asuntos en los que las fuentes proponen caminos distintos. Se presentan por separado para poder valorarlos uno a uno.</p>
      <ul class="lista">
        {cuestiones.slice(0, 4).map((q) => (
          <li class="tarjeta">
            <h3><a href={`/cuestiones/#${q.id}`}>{q.pregunta}</a></h3>
            <p class="discreto" style="margin:0">{q.opciones.map((o) => propPorId.get(o)?.titulo).join(' · ')}</p>
          </li>
        ))}
      </ul>
      <p><a href="/cuestiones/">Ver las {cuestiones.length} cuestiones</a></p>
    </section>
  </div>

  <script>
    import { iniciarBuscador } from '../../lib/buscador.js';
    iniciarBuscador();
  </script>
</Base>
