---
import Base from '../../../layouts/Base.astro';
import TarjetaPropuesta from '../../../components/TarjetaPropuesta.astro';
import { temas, propPorId, autoriaPropuesta } from '../../../lib/banco.js';

export function getStaticPaths() {
  return temas.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props;
const lista = t.propuestas.map((id) => propPorId.get(id)).filter(Boolean).sort((a, b) => (a.anio ?? 0) - (b.anio ?? 0));
const autorias = [...new Set(lista.map(autoriaPropuesta))];
---
<Base titulo={t.nombre} seccion="archivo" imagen={`/og/tema/${t.slug}.png`}
  descripcion={`${autorias.length} autorías distintas proponen sobre «${t.nombre}». Compara sus textos literales.`}>
  <nav class="migas" aria-label="Ruta"><a href="/archivo/">Archivo</a><span aria-hidden="true">›</span><a href="/archivo/temas/">Temas</a><span aria-hidden="true">›</span><span>{t.nombre}</span></nav>
  <h1>{t.nombre}</h1>
  <p class="entradilla">{lista.length} propuestas de {autorias.length} autorías distintas tratan este tema. Se muestran por orden cronológico para comparar sus textos.</p>
  <p class="discreto">Coincidir en el tema no significa coincidir en la postura. Lee cada cita completa.</p>
  <ul class="lista">{lista.map((p) => <TarjetaPropuesta p={p} modo="grupo" />)}</ul>
</Base>
