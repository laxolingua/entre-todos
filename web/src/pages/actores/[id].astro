---
import Base from '../../layouts/Base.astro';
import TarjetaConsolidada from '../../components/TarjetaConsolidada.astro';
import { actores, documentosDeActor, propuestasDeActor, TIPOS_FUENTE } from '../../lib/banco.js';

export function getStaticPaths() {
  return actores.map((a) => ({ params: { id: a.id }, props: { a } }));
}
const { a } = Astro.props;
const docs = documentosDeActor(a.id);
const lista = propuestasDeActor(a.id);
---
<Base titulo={a.nombre} seccion="actores"
  descripcion={`${a.nombre} plantea ${lista.length} de las propuestas reunidas por ENTRE TODOS.`}>
  <nav class="migas" aria-label="Ruta"><a href="/actores/">Actores</a><span aria-hidden="true">›</span><span>{a.nombre}</span></nav>
  <h1>{a.nombre}</h1>
  <ul class="cifras">
    <li>{TIPOS_FUENTE[a.tipo]}</li>
    <li><strong>{lista.length}</strong> {lista.length === 1 ? 'propuesta' : 'propuestas'}</li>
    <li><strong>{docs.length}</strong> {docs.length === 1 ? 'documento' : 'documentos'}</li>
    {a.web && <li><a href={a.web} rel="noopener" target="_blank">Sitio web</a></li>}
  </ul>
  <h2>Propuestas que plantea</h2>
  <ul class="lista">{lista.map((c) => <TarjetaConsolidada c={c} mostrarCategoria />)}</ul>
  <h2>Documentos</h2>
  <ul>{docs.map((d) => <li><a href={d.url} rel="noopener" target="_blank">{d.titulo}</a>{d.anio && <span class="discreto"> ({d.anio})</span>}</li>)}</ul>
</Base>
