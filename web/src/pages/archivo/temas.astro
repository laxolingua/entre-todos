---
import Base from '../../layouts/Base.astro';
import { temas, propPorId, autoriaPropuesta } from '../../lib/banco.js';
const filas = temas.map((t) => {
  const ps = t.propuestas.map((id) => propPorId.get(id)).filter(Boolean);
  return { ...t, n: ps.length, autorias: new Set(ps.map(autoriaPropuesta)).size };
});
---
<Base titulo="Temas en que coinciden varias fuentes" seccion="archivo"
  descripcion={`${temas.length} temas sobre los que proponen varias organizaciones o autores distintos.`}>
  <nav class="migas" aria-label="Ruta"><a href="/archivo/">Archivo</a><span aria-hidden="true">›</span><span>Temas</span></nav>
  <h1>Temas en que coinciden varias fuentes</h1>
  <p class="entradilla">Cada tema reúne propuestas de documentos distintos sobre un mismo asunto. Sirve para ver dónde se cruzan las propuestas y comparar cómo lo plantea cada una.</p>
  <div class="desplazable">
    <table class="tabla">
      <thead><tr><th scope="col">Tema</th><th scope="col">Propuestas</th><th scope="col">Autorías</th></tr></thead>
      <tbody>
        {filas.map((t) => (
          <tr><td><a href={`/archivo/tema/${t.slug}/`}>{t.nombre}</a></td><td>{t.n}</td><td>{t.autorias}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
