---
// Bandera redonda del país activo. Cuba: bandera nacional. España: bandera sin escudo (uso civil).
interface Props { pais: 'cu' | 'es'; tam?: number; }
const { pais, tam = 22 } = Astro.props;
const id = `b${pais}${Math.random().toString(36).slice(2, 8)}`;
const nombre = pais === 'es' ? 'España' : 'Cuba';
---
<svg class="bandera" width={tam} height={tam} viewBox="0 0 30 30" role="img" aria-label={`Bandera de ${nombre}`}>
  <defs><clipPath id={id}><circle cx="15" cy="15" r="15" /></clipPath></defs>
  <g clip-path={`url(#${id})`}>
    {pais === 'es' ? (
      <>
        <rect width="30" height="30" fill="#AA151B" />
        <rect y="7.5" width="30" height="15" fill="#F1BF00" />
      </>
    ) : (
      <>
        <rect width="30" height="30" fill="#fff" />
        <rect width="30" height="6" fill="#002A8F" />
        <rect y="12" width="30" height="6" fill="#002A8F" />
        <rect y="24" width="30" height="6" fill="#002A8F" />
        <path d="M0 0 L16 15 L0 30 Z" fill="#CF142B" />
        <path d="M5.6 11.2 l0.9 2.7 h2.9 l-2.3 1.7 0.9 2.7 -2.4 -1.7 -2.3 1.7 0.9 -2.7 -2.3 -1.7 h2.8 z" fill="#fff" />
      </>
    )}
  </g>
  <circle cx="15" cy="15" r="14.5" fill="none" stroke="rgba(0,0,0,.18)" />
</svg>
