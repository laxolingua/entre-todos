---
import Base from '../../layouts/Base.astro';
import datos from '../../data/organizaciones.json';
const { grupos } = datos;
const orgs = datos.organizaciones.filter((o) => o.grupo !== 'extranjeros');
const extranjeros = datos.organizaciones.filter((o) => o.grupo === 'extranjeros');
const nombreGrupo = Object.fromEntries(grupos);
const coaliciones = datos.coaliciones || [];
const slug = (t) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const coalPorFicha = Object.fromEntries(coaliciones.filter((x) => x.ficha).map((x) => [x.ficha, x]));
const totalMiembros = (x) => new Set(x.listas.flatMap((l) => l.miembros.map((m) => m.nombre))).size;
const AMBITO = { isla: 'Isla', exilio: 'Exilio', ambos: 'Isla y exilio' };
const conPropuestas = orgs.filter((o) => o.actor).length;
const PAISES = ['Cuba', 'EE. UU.', 'España', 'Alemania', 'Serbia', 'Uruguay', 'Europa'];
const paisDe = (o) => {
  const p = PAISES.filter((x) => (o.pais || '').includes(x));
  if (o.ambito === 'isla' && !p.includes('Cuba')) p.push('Cuba');
  return p;
};
const cuentaPais = Object.fromEntries(PAISES.map((x) => [x, orgs.filter((o) => paisDe(o).includes(x)).length]));
---
<Base titulo="Actores cívicos" seccion="actores"
  descripcion={`${orgs.length} organizaciones de la sociedad civil cubana, dentro y fuera de la isla. Solo información pública, con su fuente.`}>
  <h1>Actores cívicos</h1>
  <p class="entradilla">{orgs.length} organizaciones de cubanos, dentro y fuera de la isla: derechos humanos, prensa independiente, coaliciones, partidos, centros de estudio, protección animal, medio ambiente y diáspora. Solo información pública, con su fuente.</p>
  <p class="discreto">{conPropuestas} tienen propuestas en el banco de ENTRE TODOS; su ficha enlaza a ellas.</p>

  <div class="org-filtros" data-filtros>
    <div class="org-chips" role="group" aria-label="Filtrar por tipo">
      <button type="button" class="org-chip activo" data-grupo="">Todas <span>{orgs.length}</span></button>
      {grupos.map(([id, nombre]) => (
        <button type="button" class="org-chip" data-grupo={id}>{nombre} <span>{orgs.filter((o) => o.grupo === id).length}</span></button>
      ))}
    </div>
    <div class="org-busqueda">
      <label class="sr-only" for="org-q">Buscar organización</label>
      <input id="org-q" type="search" placeholder="Buscar organización" autocomplete="off" />
      <label class="sr-only" for="org-ambito">Dónde trabaja</label>
      <select id="org-ambito">
        <option value="">Isla y exilio</option>
        <option value="isla">Solo isla</option>
        <option value="exilio">Solo exilio</option>
        <option value="ambos">Ambos</option>
      </select>
      <label class="sr-only" for="org-pais">País base</label>
      <select id="org-pais">
        <option value="">Todos los países</option>
        {PAISES.filter((x) => cuentaPais[x] > 0).map((x) => <option value={x}>{x} ({cuentaPais[x]})</option>)}
      </select>
    </div>
  </div>

  <ul class="org-lista" data-lista>
    {orgs.map((o) => (
      <li id={`o-${slug(o.nombre)}`} class={`org-ficha${o.actor ? ' con-propuestas' : ''}`} data-grupo={o.grupo} data-ambito={o.ambito} data-pais={paisDe(o).join('|')} data-texto={`${o.nombre} ${o.siglas} ${o.que}`.toLowerCase()}>
        <p class="org-meta">{nombreGrupo[o.grupo]} · {AMBITO[o.ambito]}{o.pais && o.pais !== 'Exilio' && o.pais !== 'Mixto' ? ` · ${o.pais}` : ''}{o.fundada ? ` · desde ${o.fundada}` : ''}</p>
        <h2>{o.nombre}{o.siglas && !o.nombre.includes(o.siglas) ? <span class="org-siglas"> ({o.siglas})</span> : null}</h2>
        {o.estado && <span class="etiqueta">{o.estado}</span>}
        <p>{o.que}</p>
        <p class="org-enlaces">
          {o.web && <a href={o.web} rel="noopener" target="_blank">Web oficial <i class="fi fi-br-arrow-up-right-from-square" aria-hidden="true"></i></a>}
          {o.actor && <a href={`/actores/${o.actor}/`}>Sus propuestas en el banco <i class="fi fi-br-arrow-right" aria-hidden="true"></i></a>}
          {o.diversidad && <a href={`/diversidad-politica/${o.diversidad}/`}>Su ficha en Diversidad política <i class="fi fi-br-arrow-right" aria-hidden="true"></i></a>}
          {coalPorFicha[o.nombre] && <a href={`#coal-${slug(coalPorFicha[o.nombre].nombre)}`} data-abre-coal>{coalPorFicha[o.nombre].listas.length ? `Quién la integra (${totalMiembros(coalPorFicha[o.nombre])})` : 'Quién la integra'} <i class="fi fi-br-arrow-down" aria-hidden="true"></i></a>}
        </p>
      </li>
    ))}
  </ul>
  <p class="org-vacio" data-vacio hidden>No hay organizaciones con ese filtro.</p>


  {coaliciones.length > 0 && (
    <section class="org-coaliciones" id="coaliciones">
      <h2>Coaliciones y quién las integra</h2>
      <p class="discreto">Solo organizaciones, según las listas que publican las propias coaliciones o la prensa que las cita, con su fecha. Las listas cambian con el tiempo.</p>
      {coaliciones.map((x) => (
        <details class="org-coal" id={`coal-${slug(x.nombre)}`}>
          <summary><strong>{x.nombre}</strong><span>{x.listas.length ? `${totalMiembros(x)} organizaciones` : 'Sin lista pública'}</span></summary>
          <div class="org-coal-cuerpo">
            {x.nota && <p>{x.nota}</p>}
            {x.listas.map((l) => (
              <div class="org-coal-lista">
                <p class="org-meta">Lista de {l.fecha} · {l.miembros.length} · Fuente: {l.fuentes.map((f, i) => <>{i > 0 && ', '}<a href={f} rel="noopener" target="_blank">{new URL(f).hostname.replace('www.', '')}</a></>)}</p>
                <ul>{l.miembros.map((m) => <li>{m.ficha ? <a href={`#o-${slug(m.ficha)}`} data-ir-ficha>{m.nombre}</a> : m.nombre}</li>)}</ul>
              </div>
            ))}
          </div>
        </details>
      ))}
    </section>
  )}

  {extranjeros.length > 0 && (
    <section class="org-nota">
      <h2>Medios extranjeros sobre Cuba</h2>
      {extranjeros.map((o) => (
        <p><strong>{o.nombre}.</strong> {o.que} No es una organización cubana independiente; se menciona como referencia. {o.web && <a href={o.web} rel="noopener" target="_blank">Web oficial</a>}</p>
      ))}
    </section>
  )}

  <section class="org-nota">
    <h2>Cómo se elabora este registro</h2>
    <p>Reúne información ya pública sobre organizaciones de cubanos y por cubanos, con su web oficial cuando se ha comprobado. No incluye datos personales. Aparecer aquí no implica respaldo de ENTRE TODOS ni de la organización hacia ENTRE TODOS.</p>
    <p>Cualquier organización puede pedir que se corrija, se complete o se retire su ficha escribiendo a <a href="mailto:contacto.entretodos@gmail.com">contacto.entretodos@gmail.com</a>.</p>
  </section>

  <script>
    const chips = [...document.querySelectorAll('.org-chip')];
    const q = document.getElementById('org-q');
    const amb = document.getElementById('org-ambito');
    const pais = document.getElementById('org-pais');
    const fichas = [...document.querySelectorAll('.org-ficha')];
    const vacio = document.querySelector('[data-vacio]');
    let grupo = '';
    const aplicar = () => {
      const texto = (q?.value || '').trim().toLowerCase();
      const ambito = amb?.value || '';
      const p = pais?.value || '';
      let n = 0;
      fichas.forEach((f) => {
        const ok = (!grupo || f.dataset.grupo === grupo)
          && (!ambito || f.dataset.ambito === ambito)
          && (!p || (f.dataset.pais || '').split('|').includes(p))
          && (!texto || (f.dataset.texto || '').includes(texto));
        f.hidden = !ok;
        if (ok) n++;
      });
      if (vacio) vacio.hidden = n > 0;
    };
    chips.forEach((c) => c.addEventListener('click', () => {
      chips.forEach((x) => x.classList.remove('activo'));
      c.classList.add('activo');
      grupo = c.dataset.grupo || '';
      aplicar();
    }));
    q?.addEventListener('input', aplicar);
    amb?.addEventListener('change', aplicar);
    pais?.addEventListener('change', aplicar);
    // Al saltar a una ficha o a una coalición, se quitan los filtros para que se vea.
    document.querySelectorAll('[data-ir-ficha]').forEach((a) => a.addEventListener('click', () => {
      grupo = ''; chips.forEach((x) => x.classList.toggle('activo', !x.dataset.grupo));
      if (q) q.value = ''; if (amb) amb.value = ''; if (pais) pais.value = ''; aplicar();
    }));
    document.querySelectorAll('[data-abre-coal]').forEach((a) => a.addEventListener('click', () => {
      const d = document.querySelector(a.getAttribute('href') || '');
      if (d instanceof HTMLDetailsElement) d.open = true;
    }));
  </script>
</Base>
