---
import { fotoLeccion } from '../../data/academia-fotos.js';
// Blog académico: entradas que se leen como artículos y se convierten en lección con un botón.
import Base from '../../layouts/Base.astro';
import Banda from '../../components/Banda.astro';
import ApoyoEEUU from '../../components/ApoyoEEUU.astro';
import CertificadoPanel from '../../components/CertificadoPanel.astro';
import { MODULOS as MOD_CERT } from '../../lib/certificados.js';
import { cursos } from '../../data/academia.js';
import { entradas } from '../../data/academia-entradas.js';

const FOTOS = ['derechos', 'constitucion', 'sociedad_civil', 'transicion'];
const MODULOS = [
  { id: 'la-nueva-cuba', titulo: 'La nueva Cuba', texto: 'Cómo podría funcionar la nueva Cuba: derechos, libertades, justicia y democracia, comparados con el derecho internacional y otras democracias.' },
  { id: 'pensar-y-debatir', titulo: 'Pensar y debatir', texto: 'Pensamiento crítico, creativo, ético, sistémico, humano y solucionario: argumentar, comprobar fuentes y debatir sin ofender.' },
];
const modRef = { 'la-nueva-cuba': 'nc', 'pensar-y-debatir': 'pd' };
const leccionesDe = (mid) => cursos.filter((c) => (c.modulo === 'Pensar y debatir' ? 'pensar-y-debatir' : 'la-nueva-cuba') === mid && c.estado === 'disponible')
  .flatMap((c) => c.lecciones.filter((l) => entradas[l.id]).map((l) => [c.id, l.id]));
const modDe = (c) => (c.modulo === 'Pensar y debatir' ? 'pensar-y-debatir' : 'la-nueva-cuba');
const publicadas = cursos.filter((c) => c.estado === 'disponible').flatMap((c) =>
  c.lecciones.filter((l) => entradas[l.id]).map((l, n) => ({ c, l, n, e: entradas[l.id], foto: fotoLeccion(c, l, n).src })));
---
<Base titulo="Blog A+" seccion="academia" ancho
  descripcion="Lecturas breves sobre derechos, libertades y democracia que se convierten en lección con un botón: actividades, insignias y certificado. Sin cuenta y sin datos personales.">
  <Banda imagen="/img/fotos/academia.jpg" lateral={['Democracia', 'Derechos humanos', 'Ciudadanía', 'Ética']}>
    <span class="barra"></span>
    <h1>Blog A<sup>+</sup></h1>
    <p class="lema">Blog A+ de ENTRE TODOS</p>
    <p class="entradilla">Lecturas sobre cómo podría funcionar la nueva Cuba: derechos, libertades y democracia. Cada una parte de una duda y se puede convertir en lección con actividades, insignia e informe.</p>
  </Banda>
  <div class="contenedor">
    <nav class="bl-modulos" aria-label="Secciones del Blog A+">
      {MODULOS.map((m) => <a href={`#${m.id}`}><strong>{m.titulo}</strong><span>{m.texto}</span></a>)}
      <a href="/academia/conceptos/"><strong>Conceptos</strong><span>República, parlamentario, separación de poderes, referéndum: qué es cada cosa y qué cambia para quien vota.</span></a>
      <a href="/academia/biblioteca/"><strong>Biblioteca</strong><span>Tratados y documentos internacionales, con el texto oficial y la situación de Cuba.</span></a>
      <a href="/generador-de-soluciones/"><strong>Generador de soluciones</strong><span>De un problema a una propuesta, paso a paso, solo o en grupo.</span></a>
    </nav>
    <p class="discreto"><a href="/academia/itinerario/">Itinerario: para qué sirve cada bloque</a></p>
    {MODULOS.map((m) => (
      <section class="seccion bl-modulo" id={m.id}>
        <h2>{m.titulo}</h2>
        <p class="discreto">{m.texto}</p>
        <h3 class="bl-sub-h">Bloques</h3>
        <ul class="cursos">
        {cursos.filter((c) => modDe(c) === m.id).map((c) => (
          <li class="curso con-foto">
            <a class="curso-enlace" href={`/academia/${c.id}/`} aria-label={c.titulo}></a>
            <div class="duo"><img src={`/img/fotos/cat-${c.foto}.jpg`} alt="" loading="lazy" /></div>
            <span class="num">{String(c.num).padStart(2, '0')}</span>
            <div class="pie-curso">
              <h3>{c.titulo}</h3>
              {c.estado === 'disponible'
                ? <span class="estado disponible">{c.lecciones.length} entradas · {c.minutos} min</span>
                : <span class="estado">En preparación</span>}
            </div>
          </li>
        ))}
      </ul>
        <h3 class="bl-sub-h">Entradas</h3>
        <ul class="bl-tarjetas">
        {publicadas.filter((x) => modDe(x.c) === m.id).map(({ c, l, n, e, foto }) => (
          <li class="bl-tarjeta" data-clave={`et-blog-${c.id}-${l.id}`}>
            <a href={`/academia/${c.id}/${l.id}/`}>
              <img src={foto} alt="" loading="lazy" />
              <span class="bl-tarjeta-txt">
                <span class="bl-tarjeta-meta">{c.titulo} · {n + 1} de {c.lecciones.length} · {l.minutos} min</span>
                <strong>{l.titulo}</strong>
                <span>{e.entradilla}</span>
                <span class="bl-estado" data-estado></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      </section>
    ))}
    <section class="seccion" id="certificado-a">
      <h2>Certificado Academia A<sup>+</sup></h2>
      <p>Hay tres niveles: una insignia por lección, un certificado por bloque y el Certificado Academia A<sup>+</sup> de ENTRE TODOS al completar un módulo entero. Cada certificado tiene un código que cualquiera puede comprobar en <a href="/verificar/">entre-todos.org/verificar</a>.</p>
      <ul class="cm-mods">
        {MODULOS.map((m) => (
          <li data-cm={m.id} data-cm-lecciones={JSON.stringify(leccionesDe(m.id))}>
            <strong>{m.titulo}</strong>
            <span class="bl-progreso"><span data-cm-texto>0 de {leccionesDe(m.id).length} lecciones</span><span class="bl-barra"><i data-cm-barra></i></span></span>
          </li>
        ))}
      </ul>
      {MODULOS.map((m) => (
        <div class="cm-panel" data-cm-panel={m.id} hidden>
          <h3>Tu certificado: {m.titulo}</h3>
          <CertificadoPanel tipo="modulo" refId={modRef[m.id]} etiqueta="Academia cívica · Certificado" titulo="Academia A+"
            detalle={MOD_CERT[modRef[m.id]].detalle} nombreCert={`Certificado Academia A+ de ENTRE TODOS: ${m.titulo}`} lecciones={leccionesDe(m.id)} />
        </div>
      ))}
    </section>
    <ApoyoEEUU pieza="material" />
  </div>
  <script>
    document.querySelectorAll('[data-cm]').forEach((li) => {
      const ls = JSON.parse(li.getAttribute('data-cm-lecciones') || '[]');
      const n = ls.filter(([b, l]) => { try { return !!JSON.parse(localStorage.getItem(`et-blog-${b}-${l}`) || '{}').insignia; } catch (e) { return false; } }).length;
      const t = li.querySelector('[data-cm-texto]'); if (t) t.textContent = `${n} de ${ls.length} lecciones`;
      const b = li.querySelector('[data-cm-barra]'); if (b instanceof HTMLElement) b.style.width = `${Math.round((n / Math.max(1, ls.length)) * 100)}%`;
      if (ls.length && n === ls.length) document.querySelector(`[data-cm-panel="${li.getAttribute('data-cm')}"]`)?.removeAttribute('hidden');
    });
    document.querySelectorAll('[data-clave]').forEach((li) => {
      try {
        const s = JSON.parse(localStorage.getItem(li.getAttribute('data-clave') || '') || '{}');
        const est = li.querySelector('[data-estado]');
        if (est && s.insignia) { est.textContent = 'Insignia obtenida'; li.classList.add('hecha'); }
        else if (est && (s.antes !== undefined || s.modo)) est.textContent = 'Empezada';
      } catch (e) { /* sin almacenamiento */ }
    });
  </script>
</Base>

<style>
  .cm-mods { list-style: none; padding: 0; margin: 14px 0 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
  .cm-mods li { background: #fff; border: 1px solid var(--borde); border-top: 4px solid var(--marino); padding: 14px 16px; display: grid; gap: 8px; }
  .cm-mods strong { font-family: var(--display); text-transform: uppercase; color: var(--marino); font-size: 1.1rem; }
  .cm-panel { margin-top: 18px; }
  .cm-panel[hidden] { display: none; }
</style>
