---
import Base from '../../layouts/Base.astro';
import { meta } from '../../lib/banco.js';
const t = meta.totales;
const archivos = [
  { href: '/datos/propuestas.csv', nombre: 'Propuestas (CSV)', detalle: `${t.propuestas} propuestas con su texto, incisos, variantes, categoría y quién las plantea.` },
  { href: '/datos/documentos.csv', nombre: 'Documentos (CSV)', detalle: `${t.documentos} documentos con autoría, año y enlace al original.` },
  { href: '/datos/propuestas.json', nombre: 'Todo en JSON', detalle: 'Propuestas, incisos, variantes, cuestiones, categorías, actores y documentos en un solo archivo.' },
];
---
<Base titulo="Datos abiertos" seccion="datos"
  descripcion="Descarga las propuestas reunidas por ENTRE TODOS en CSV o JSON.">
  <h1>Datos abiertos</h1>
  <p class="entradilla">Las propuestas se pueden descargar para investigar, comparar o reutilizar. Cada propuesta indica sus documentos y el enlace a cada original.</p>
  <ul class="lista">
    {archivos.map((a) => (
      <li class="tarjeta">
        <h3><a href={a.href} download><i class="fi fi-br-download" aria-hidden="true" style="margin-right:8px"></i>{a.nombre}</a></h3>
        <p class="discreto" style="margin:0">{a.detalle}</p>
      </li>
    ))}
  </ul>
  <p class="discreto" style="margin-top:20px">Archivos en UTF-8. En los CSV, las listas van separadas por «|».</p>
</Base>
